# ── Required ──────────────────────────────────────────────
PRIVATE_KEY=0xYourPrivateKeyHere
WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Mode ──────────────────────────────────────────────────
# LIVE_MODE=1              # Set to 1 to trade with real money
# DRY_RUN=true             # Set to true to simulate without real orders
# KILL_SWITCH=0            # Set to 1 to immediately halt all new trades

# ── Wallet ────────────────────────────────────────────────
# FUNDER_ADDRESS=0x...     # Required if using Magic or Safe signature type
# SIGNATURE_TYPE=0         # 0=EOA (default), 1=Magic, 2=Safe

# ── Network ───────────────────────────────────────────────
# RPC_URL=https://polygon-rpc.com   # HTTP fallback if no WSS_URL

# ── Target whale to copy ──────────────────────────────────
# TEST_ADDRESS=0xWhaleAddressHere

# ── Risk controls (tune to your account size) ─────────────
# MAX_DAILY_USDC=100           # Max USDC to spend per day on new BUYs
# MAX_POSITION_USDC=50         # Max cost basis per open position
# MAX_TRADE_USDC=25            # Max USDC risked on a single trade
# MIN_BALANCE_USDC=20          # Stop buying if USDC balance drops below this
# MAX_DAILY_DRAWDOWN_USDC=30   # Halt all BUYs if daily losses exceed this

# ── Logging ───────────────────────────────────────────────
# LOG_LEVEL=info               # debug | info | warn | error
